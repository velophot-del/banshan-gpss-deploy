# 应用监听
PORT=3012
HOST=127.0.0.1

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=banshan
USE_SOCKET=false
DB_SOCKET_PATH=/tmp/mysql.sock
DB_CREATE_IF_MISSING=false

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 前端地址（CORS）
FRONTEND_URL=http://127.0.0.1:5174

# 文件上传目录
UPLOAD_DIR=./uploads

# 进入毕业设计管理系统的链接
GPSS_URL=http://127.0.0.1:3001
