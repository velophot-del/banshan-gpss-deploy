# ============================================================
# 半山学堂 + 毕业设计管理系统 统一部署环境变量
# 复制为 .env 后按实际值填写（docker compose 会读取此文件做变量替换）
# ============================================================

# ---- 通用 ----
TZ=Asia/Shanghai
# 对外访问地址（用于 CORS，写域名或公网 IP，如 http://example.com 或 http://47.x.x.x）
PUBLIC_URL=http://你的域名或IP
# Nginx 对外端口（默认 80）
HTTP_PORT=80
# 启用 HTTPS 时取消注释（配合 nginx-https.conf 使用）
# HTTPS_PORT=443

# ---- MySQL（单实例，banshan + gpss 两库共用）----
MYSQL_ROOT_PASSWORD=请设置一个强root密码
# 应用连接账号固定为 app，两库共用这一个密码（首次初始化会自动创建 banshan、gpss 两个库）
DB_PASSWORD=请设置app账号密码

# 库名（一般保持默认即可；迁移旧数据时改成与旧库一致）
BANSHAN_DB_NAME=banshan
GPSS_DB_NAME=gpss

# ---- JWT 密钥（两套独立，各设一个随机长字符串）----
# 可用 `openssl rand -hex 32` 生成
BANSHAN_JWT_SECRET=请设置为随机长字符串A
GPSS_JWT_SECRET=请设置为随机长字符串B
